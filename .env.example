APP_ENV=production
APP_DEBUG=false
APP_URL=https://licenses.example.com
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
TIMEZONE=Europe/Istanbul
JWT_SECRET=change-this-secret
JWT_ISSUER=https://licenses.example.com
JWT_AUDIENCE=https://licenses.example.com/api
JWT_TTL=3600
JWT_REFRESH_TTL=1209600
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=licenses
DB_USERNAME=license_user
DB_PASSWORD=secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
LOG_CHANNEL=daily
LOG_PATH=storage/logs/app.log
LOG_LEVEL=info
HASH_SALT=change-me
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_WINDOW=60
CORS_ALLOWED_ORIGINS=https://client.example.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Access-Key,X-Signature,X-Timestamp,X-Nonce
CORS_EXPOSE_HEADERS=Retry-After
CORS_MAX_AGE=600
HMAC_ALGO=sha256
OFFLINE_SIGN_PRIVATE_KEY_PATH=storage/keys/private.key
OFFLINE_SIGN_PUBLIC_KEY_PATH=storage/keys/public.key
WEBHOOK_QUEUE_DRIVER=sync
CACHE_PATH=storage/cache
