RewriteEngine On
RewriteBase /

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^admin$ /admin/index.php [L,QSA]
RewriteRule ^admin/(.*)$ /admin/$1 [L,QSA]
RewriteRule ^api/(.*)$ /api/$1 [L,QSA]
RewriteRule ^tracking$ /index.php [L,QSA]
RewriteRule ^pricing$ /index.php [L,QSA]
RewriteRule ^contact$ /index.php [L,QSA]
RewriteRule ^page/([0-9]+)/([a-zA-Z0-9-]+)$ /index.php [L,QSA]
RewriteRule ^active-shipments$ /index.php [L,QSA]
RewriteRule ^$ /index.php [L,QSA]
