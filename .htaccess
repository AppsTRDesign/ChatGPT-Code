RewriteEngine On

RewriteRule ^sitemap\.xml$ includes/sitemap.php?section=index [L,QSA]
RewriteRule ^sitemap-pages\.xml$ includes/sitemap.php?section=pages [L,QSA]
RewriteRule ^sitemap-categories\.xml$ includes/sitemap.php?section=categories [L,QSA]
RewriteRule ^sitemap-([0-9]+)\.xml$ includes/sitemap.php?section=products&page=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^contents/?$ content.php [L,QSA]
RewriteRule ^cart/?$ cart.php [L,QSA]
RewriteRule ^faq/?$ faq.php [L,QSA]
RewriteRule ^contact/?$ contact.php [L,QSA]
RewriteRule ^login/?$ login.php [L,QSA]
RewriteRule ^register/?$ register.php [L,QSA]
RewriteRule ^profile/?$ profile.php [L,QSA]
RewriteRule ^addresses/?$ addresses.php [L,QSA]
RewriteRule ^orders/?$ orders.php [L,QSA]
RewriteRule ^order-tracking/?$ order-tracking.php [L,QSA]
RewriteRule ^favorites/?$ favorites.php [L,QSA]
RewriteRule ^reviews/?$ reviews.php [L,QSA]
RewriteRule ^logout/?$ logout.php [L,QSA]
RewriteRule ^product/([^/]+)/?$ product.php?slug=$1 [L,QSA]
RewriteRule ^category/([^/]+)/?$ category.php?slug=$1 [L,QSA]
RewriteRule ^categories/?$ categories.php [L,QSA]
RewriteRule ^page/([^/]+)/?$ page.php?slug=$1 [L,QSA]

# Legacy Turkish aliases
RewriteRule ^icerikler/?$ content.php [L,QSA]
RewriteRule ^sepet/?$ cart.php [L,QSA]
RewriteRule ^sss/?$ faq.php [L,QSA]
RewriteRule ^iletisim/?$ contact.php [L,QSA]
RewriteRule ^giris/?$ login.php [L,QSA]
RewriteRule ^kayit/?$ register.php [L,QSA]
RewriteRule ^profil/?$ profile.php [L,QSA]
RewriteRule ^adresler/?$ addresses.php [L,QSA]
RewriteRule ^siparisler/?$ orders.php [L,QSA]
RewriteRule ^kargo-takip/?$ order-tracking.php [L,QSA]
RewriteRule ^favoriler/?$ favorites.php [L,QSA]
RewriteRule ^yorumlar/?$ reviews.php [L,QSA]
RewriteRule ^cikis/?$ logout.php [L,QSA]
RewriteRule ^urun/([^/]+)/?$ product.php?slug=$1 [L,QSA]
RewriteRule ^kategori/([^/]+)/?$ category.php?slug=$1 [L,QSA]
RewriteRule ^kategoriler/?$ categories.php [L,QSA]
RewriteRule ^sayfa/([^/]+)/?$ page.php?slug=$1 [L,QSA]
