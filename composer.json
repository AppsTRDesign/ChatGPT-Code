{
    "name": "noasoft/telegrambot",
    "description": "Telegram automation dashboard with admin panel",
    "type": "project",
    "require": {
        "php": "^8.0",
        "vlucas/phpdotenv": "^5.6",
        "guzzlehttp/guzzle": "^7.8",
        "irazasyed/telegram-bot-sdk": "^3.8",
        "danog/madelineproto": "^8.1",
        "phpmailer/phpmailer": "^6.8",
        "monolog/monolog": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php -r \"file_exists('bootstrap/cache') || mkdir('bootstrap/cache', 0775, true);\""
        ]
    },
    "config": {
        "sort-packages": true
    }
}
