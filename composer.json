{
    "name": "noasoft/fileupload-platform",
    "description": "Modern AJAX tabanlı dosya yükleme ve yönetim sistemi",
    "type": "project",
    "require": {
        "php": "^8.0",
        "ext-pdo": "*"
    },
    "autoload": {
        "files": ["functions.php"],
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "@composer dump-autoload"
        ],
        "post-update-cmd": [
            "@composer dump-autoload"
        ]
    }
}
