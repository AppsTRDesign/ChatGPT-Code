{
    "name": "licensing/platform",
    "description": "Production-ready licensing management system built with Slim 4 and Eloquent.",
    "type": "project",
    "require": {
        "php": "^8.2",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "illuminate/database": "^10.0",
        "illuminate/events": "^10.0",
        "monolog/monolog": "^3.5",
        "vlucas/phpdotenv": "^5.5",
        "firebase/php-jwt": "^6.10",
        "paragonie/sodium_compat": "^1.20",
        "ramsey/uuid": "^4.7",
        "symfony/var-dumper": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "friendsofphp/php-cs-fixer": "^3.45",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"if (!is_dir('storage/logs')) { mkdir('storage/logs', 0775, true); }\""
        ],
        "post-update-cmd": [
            "@composer run post-install-cmd"
        ],
        "migrate": "php scripts/migrate.php",
        "seed": "php scripts/seed.php",
        "test": "phpunit",
        "cs-fix": "php-cs-fixer fix"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
