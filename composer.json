{
    "name": "noasoft/fileupload-platform",
    "description": "Modern AJAX tabanlı dosya yükleme ve yönetim sistemi",
    "type": "project",
    "require": {
        "php": "^8.0",
        "ext-pdo": "*",
        "piwik/device-detector": "^6.1",
        "geoip2/geoip2": "^2.13",
        "phpmailer/phpmailer": "^6.9",
        "iyzico/iyzipay-php": "^2.0",
        "stripe/stripe-php": "^15.0",
        "cboden/ratchet": "^0.4"
    },
    "autoload": {
        "files": ["functions.php"],
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "@composer dump-autoload"
        ],
        "post-update-cmd": [
            "@composer dump-autoload"
        ]
    }
}
